---
import ContentPost from '../../layouts/ContentPost.astro';
import { getPublishedPosts, legacySectionOf } from '../../lib/posts';
import type { Post } from '../../lib/posts';

// TEMPORARY (phase 3 replaces this with /blog/[...slug]): posts are still served under their old section URL.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((entry) => ({
    params: { collection: legacySectionOf(entry), slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: Post;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, pubDate, tags, author, publicationYear } = entry.data;
---

<ContentPost
  title={title}
  pubDate={pubDate}
  tags={tags}
  collection={legacySectionOf(entry)}
  author={author}
  publicationYear={publicationYear}
>
  <Content />
</ContentPost>
