---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContentListItem from '../../components/ContentListItem.astro';
import { t, getLocaleFromUrl, getDateLocale } from '../../i18n/utils';
import { getPublishedPosts, legacySectionOf } from '../../lib/posts';
import type { Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  const uniqueTags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props as Props;
const locale = getLocaleFromUrl(Astro.url);

const heading = `${t(locale, 'tag.pages')} ${t(locale, 'tag.taggedWith')} "${tag}"`;
---

<BaseLayout
  title={heading}
  description={`${t(locale, 'tag.pages')} ${t(locale, 'tag.taggedWith')} ${tag}`}
>
  <Header slot="header" />

  <div class="main-container space-y-8">
    <div class="mb-8">
      <a href="/" class="link-back">
        ← {t(locale, 'content.backTo')} {t(locale, 'nav.home')}
      </a>
    </div>

    <section>
      <h1 class="text-4xl font-bold text-white mb-6">
        {heading}
      </h1>

      {posts.length > 0 ? (
        <ul class="content-list">
          {posts.map(post => (
            <ContentListItem
              title={post.data.title}
              slug={post.slug}
              collection={legacySectionOf(post)}
              metadata={`${t(locale, 'card.in')} ${legacySectionOf(post)} · ${post.data.pubDate.toLocaleDateString(getDateLocale(locale), {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}`}
            />
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <p class="empty-message">{t(locale, 'tag.noResults')}</p>
        </div>
      )}
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
